# ============================================================
# NetOps Sentinel - Environment Configuration Template
# ============================================================
#
# Copy this file to ".env" for local development:
#
#   Copy-Item .env.example .env
#
# Never commit the resulting .env file.
# Never place real credentials in this template.


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NETOPS_ENVIRONMENT=development
NETOPS_LOG_LEVEL=INFO


# ------------------------------------------------------------
# Model provider
# ------------------------------------------------------------
#
# Supported initially:
#   mock
#
# Planned:
#   nebius
#
# Local development starts with the mock provider so that the
# project remains fully testable without external credentials.

NETOPS_MODEL_PROVIDER=mock


# ------------------------------------------------------------
# Nebius / NVIDIA
# ------------------------------------------------------------
#
# Leave empty until Nebius access is configured.
# Never commit a real API key.

NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=


# ------------------------------------------------------------
# LangSmith observability
# ------------------------------------------------------------

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=netops-sentinel


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
#
# Database support will be introduced in a later milestone.

DATABASE_URL=
